# GameCraft Studio - Apache configuration for cPanel

# Stop directory listings
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # If the app sits in a sub-folder, uncomment the line below and set the path
    # RewriteBase /gamecraft/

    # Never rewrite real files or folders (images, css, js)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else goes to index.php
    RewriteRule ^ index.php [L]
</IfModule>

# Block direct access to source and configuration
<FilesMatch "^(config\.php|config\.example\.php)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Compress text responses
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# Cache static files
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
</IfModule>
