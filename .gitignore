# ---------------------------------------------------------------------
#  Never commit: database credentials
# ---------------------------------------------------------------------
# config.php holds your live database user and password.
# Copy config.example.php to config.php on each machine instead.
/config.php


# ---------------------------------------------------------------------
#  Never commit: user data
# ---------------------------------------------------------------------
# The local SQLite database contains real accounts and password hashes
storage/*.sqlite
storage/*.sqlite-wal
storage/*.sqlite-shm

storage/logs/*
!storage/logs/.gitkeep
storage/cache/*
!storage/cache/.gitkeep

# Images uploaded by users
uploads/backgrounds/**
uploads/covers/**
!uploads/backgrounds/.gitkeep
!uploads/covers/.gitkeep


# ---------------------------------------------------------------------
#  Artwork
# ---------------------------------------------------------------------
# Library artwork IS versioned. It is what makes a fresh clone look like the
# product rather than a wireframe, and at ~20 MB that is worth the weight.
# Uploads made by users are still kept out - see the section above.


# ---------------------------------------------------------------------
#  Build output
# ---------------------------------------------------------------------
gamecraft.zip
*.zip


# ---------------------------------------------------------------------
#  Editor and OS noise
# ---------------------------------------------------------------------
.claude/
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store


# ---------------------------------------------------------------------
#  Leftovers from an earlier Next.js scaffold that OneDrive keeps restoring
# ---------------------------------------------------------------------
node_modules/
.next/
src/
public/
next-env.d.ts
package.json
package-lock.json
tsconfig.json
